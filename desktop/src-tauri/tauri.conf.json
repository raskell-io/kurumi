{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kurumi",
  "version": "../../package.json",
  "identifier": "io.raskell.kurumi",
  "build": {
    "frontendDist": "../../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../.. run dev"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage"],
    "category": "Productivity",
    "copyright": "Copyright © Raffael Schneider",
    "shortDescription": "Local-first second brain",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
